{%- comment -%}
  Renders category links and Shopify Storefront filters.
  Uses standard GET form so filters work without JS.
{%- endcomment -%}
<form method="get" class="filters">
  {%- if collection.sort_by != blank -%}
    <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
  {%- endif -%}

  <fieldset class="filter-group">
    <legend class="filter-group__title">Category</legend>
    <div class="filter-group__options">
      <a href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' %}class="is-active" aria-current="page"{% endif %}>All products</a>
      {%- assign category_handles = 'smart-rings,smart-watches,fitness-trackers,accessories' | split: ',' -%}
      {%- for handle in category_handles -%}
        {%- assign category_collection = collections[handle] -%}
        {%- assign fallback_title = handle | replace: '-', ' ' | capitalize -%}
        <a href="{% if category_collection != blank %}{{ category_collection.url }}{% else %}/collections/{{ handle }}{% endif %}" {% if collection.handle == handle %}class="is-active" aria-current="page"{% endif %}>
          {{ category_collection.title | default: fallback_title }}
        </a>
      {%- endfor -%}
    </div>
  </fieldset>

  {%- if collection.filters != blank -%}
    {%- for filter in collection.filters -%}
      <fieldset class="filter-group">
        <legend class="filter-group__title">{{ filter.label }}</legend>
        <div class="filter-group__options">
          {%- case filter.type -%}
            {%- when 'list' or 'boolean' -%}
              {%- for value in filter.values -%}
                <label>
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <span>{{ value.label }} ({{ value.count }})</span>
                </label>
              {%- endfor -%}
            {%- when 'price_range' -%}
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-items: center;">
                <input type="number" placeholder="Min" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: '' }}" min="0">
                <input type="number" placeholder="Max" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: '' }}" min="0">
              </div>
          {%- endcase -%}
        </div>
      </fieldset>
    {%- endfor -%}
  {%- endif -%}

  {%- if collection.filters == blank -%}
    {%- comment -%} Fallback price filter via tags / price params {%- endcomment -%}
    <fieldset class="filter-group">
      <legend class="filter-group__title">Price</legend>
      <div class="filter-group__options">
        <a href="{{ collection.url }}?filter.v.price.lte=100">Under $100</a>
        <a href="{{ collection.url }}?filter.v.price.gte=100&filter.v.price.lte=300">$100 - $300</a>
        <a href="{{ collection.url }}?filter.v.price.gte=300">$300+</a>
      </div>
    </fieldset>
  {%- endif -%}

  <button type="submit" class="btn btn--primary btn--sm">Apply filters</button>
  <a href="{{ collection.url }}" class="btn btn--ghost btn--sm">Clear all</a>
</form>
