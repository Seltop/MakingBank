{%- comment -%} SEO + Open Graph meta tags {%- endcomment -%}
{%- liquid
  if template.name == 'product' and product
    assign og_title = product.title | escape
    assign og_description = product.description | strip_html | truncatewords: 40 | escape
    assign og_image = product.featured_media.preview_image | image_url: width: 1200
    assign og_type = 'product'
    assign og_url = shop.url | append: product.url
  elsif template.name == 'collection' and collection
    assign og_title = collection.title | escape
    assign og_description = collection.description | strip_html | truncatewords: 40 | escape
    assign og_image = collection.featured_image | image_url: width: 1200
    assign og_type = 'website'
    assign og_url = shop.url | append: collection.url
  elsif template.name == 'article' and article
    assign og_title = article.title | escape
    assign og_description = article.excerpt_or_content | strip_html | truncatewords: 40 | escape
    assign og_image = article.image | image_url: width: 1200
    assign og_type = 'article'
    assign og_url = shop.url | append: article.url
  else
    assign og_title = page_title | escape
    assign og_description = page_description | default: shop.description | escape
    if settings.share_image
      assign og_image = settings.share_image | image_url: width: 1200
    endif
    assign og_type = 'website'
    assign og_url = canonical_url
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_description != blank -%}<meta property="og:description" content="{{ og_description }}">{%- endif -%}
{%- if og_image -%}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
{%- if og_description != blank -%}<meta name="twitter:description" content="{{ og_description }}">{%- endif -%}
{%- if og_image -%}<meta name="twitter:image" content="{{ og_image }}">{%- endif -%}

{%- if template.name == 'product' and product -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "image": [{{ product.featured_media.preview_image | image_url: width: 1200 | json }}],
      "description": {{ product.description | strip_html | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.00 | json }},
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
      }
    }
  </script>
{%- endif -%}
