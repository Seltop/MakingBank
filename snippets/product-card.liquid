{%- comment -%}
  Renders a single product card for grids.
  Accepts:
    product (object, required)
    show_vendor (bool)
    show_quick_add (bool, default true)
{%- endcomment -%}
{%- liquid
  if show_quick_add == nil
    assign show_quick_add = true
  endif
  assign featured = product.featured_media
  assign second = product.media[1]
-%}

<article class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media-wrap">
    <a href="{{ product.url | within: collection }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {% render 'product-badges', product: product %}
      {%- if featured -%}
        <img
          class="product-card__media--primary"
          src="{{ featured | image_url: width: 600 }}"
          alt="{{ featured.alt | default: product.title | escape }}"
          loading="lazy" width="600" height="600">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__media--primary' }}
      {%- endif -%}
      {%- if second -%}
        <img
          class="product-card__media--alt"
          src="{{ second | image_url: width: 600 }}"
          alt="{{ second.alt | default: product.title | escape }}"
          loading="lazy" width="600" height="600">
      {%- endif -%}
    </a>

    {%- if show_quick_add and product.available -%}
      {%- if product.variants.size > 1 -%}
        <a href="{{ product.url | within: collection }}" class="btn btn--secondary btn--sm product-card__quick">View options</a>
      {%- else -%}
        <button type="button"
          class="btn btn--primary btn--sm btn--full product-card__quick"
          data-quick-add="{{ product.selected_or_first_available_variant.id }}"
          data-default-text="Add to cart">
          Add to cart
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
    </h3>
    {% render 'price', product: product %}

    {%- assign color_option = nil -%}
    {%- for opt in product.options_with_values -%}
      {%- assign opt_name = opt.name | downcase -%}
      {%- if opt_name contains 'color' or opt_name contains 'colour' -%}
        {%- assign color_option = opt -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if color_option -%}
      <div class="product-card__swatches" aria-label="Available colors">
        {%- for v in color_option.values limit: 5 -%}
          <span class="swatch" style="background:{{ v | downcase | split: ' ' | first | replace: 'rose', '#f7c1c1' | replace: 'silver', '#c0c4c9' | replace: 'gold', '#d4af37' | replace: 'black', '#0b1220' | replace: 'white', '#ffffff' | replace: 'graphite', '#3a3f45' | replace: 'midnight', '#0e1730' | replace: 'stealth', '#1a1a1a' | replace: 'champagne', '#e6c8a0' }}" title="{{ v | escape }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
