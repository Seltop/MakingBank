<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {% style %}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --color-surface: {{ settings.color_surface }};
        --color-card: #fff;
        --font-body: {{ settings.type_body_font.family }}, sans-serif;
        --font-heading: {{ settings.type_heading_font.family }}, sans-serif;
      }
    {% endstyle %}
  </head>
  <body style="min-height:100vh; display:flex; align-items:center; justify-content:center; background: var(--color-surface);">
    <div style="max-width: 480px; margin: 40px; padding: 48px; background: #fff; border-radius: 16px; text-align:center; box-shadow: 0 12px 40px rgba(0,0,0,.06);">
      <h1>{{ shop.name }}</h1>
      <p class="text-muted">Opening soon. Sign up to be the first to know.</p>
      {% form 'storefront_password' %}
        <input type="password" name="password" placeholder="Enter password" required style="width:100%; padding:12px 16px; border:1px solid var(--color-border); border-radius:999px; margin: 16px 0;">
        <button type="submit" class="btn btn--primary btn--full">Enter</button>
        {%- if form.errors -%}<p style="color:#d12c2c; margin-top:8px;">{{ form.errors.messages.form }}</p>{%- endif -%}
      {% endform %}
    </div>
    {{ content_for_layout }}
  </body>
</html>
