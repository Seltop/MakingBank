<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <title>{{ shop.name }} — Opening soon</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
    -%}
    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --color-card: {{ settings.color_card }};
        --color-surface: {{ settings.color_surface }};
        --color-ink: #0A0B0F;
        --color-ink-soft: #1B1E26;
        --accent-rgb: 255, 74, 28;
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      }
    {% endstyle %}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

    <script>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body class="password-page">
    <div class="password-page__noise" aria-hidden="true"></div>
    <div class="password-page__glow" aria-hidden="true"></div>

    <main class="password-page__wrap">

      <header class="password-page__brand">
        {%- if settings.logo != blank -%}
          {%- assign logo_w = settings.logo_width | default: 130 -%}
          {%- assign logo_h = logo_w | divided_by: settings.logo.aspect_ratio | round -%}
          <img src="{{ settings.logo | image_url: width: 280 }}" alt="{{ shop.name | escape }}" class="password-page__logo" width="{{ logo_w }}" height="{{ logo_h }}" style="width:{{ logo_w }}px; height:auto;">
        {%- else -%}
          <span class="password-page__wordmark">{{ shop.name }}<i>.</i></span>
        {%- endif -%}
      </header>

      <div class="password-page__grid">

        <section class="password-page__intro">
          <span class="eyebrow eyebrow--accent eyebrow--solo">Opening soon</span>
          <h1 class="password-page__heading">Something extraordinary is about to drop.</h1>
          <p class="password-page__copy">Wearable tech, reimagined for daily life. Sign up to be the first to know when Pulse goes live — early access, founding-member pricing, and a sizing kit on us.</p>

          {% form 'customer' %}
            <div class="password-page__signup">
              <label for="signup-email" class="visually-hidden">Email address</label>
              <input type="hidden" name="contact[tags]" value="prospect, password page">
              <div class="password-page__signup-input">
                <input type="email" id="signup-email" name="contact[email]" placeholder="Enter your email" required autocomplete="email">
                <button type="submit" class="btn btn--primary">
                  <span>Notify me</span>
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="password-page__signup-success">Thanks — you're on the list.</p>
              {%- elsif form.errors -%}
                <p class="password-page__signup-error">{{ form.errors | default_errors }}</p>
              {%- endif -%}
            </div>
          {% endform %}

          {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_x != blank or settings.social_facebook != blank -%}
            <div class="password-page__social">
              <span>Follow along</span>
              {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 18 %}</a>{%- endif -%}
              {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 18 %}</a>{%- endif -%}
              {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube', size: 18 %}</a>{%- endif -%}
              {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x', size: 18 %}</a>{%- endif -%}
              {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 18 %}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </section>

        <aside class="password-page__access">
          <div class="password-page__access-card">
            <span class="eyebrow eyebrow--solo">Have a password?</span>
            <h2 class="password-page__access-title">Enter the store</h2>
            {% form 'storefront_password' %}
              <label for="storefront-password" class="visually-hidden">Password</label>
              <input type="password" id="storefront-password" name="password" placeholder="Password" required autocomplete="off">
              <button type="submit" class="btn btn--primary btn--full btn--lg">
                {% render 'icon', name: 'lock', size: 16 %}
                <span>Unlock</span>
              </button>
              {%- if form.errors -%}
                <p class="password-page__error">{{ form.errors.messages.form }}</p>
              {%- endif -%}
            {% endform %}
          </div>
        </aside>

      </div>

      <footer class="password-page__footer">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        <a href="https://www.shopify.com" target="_blank" rel="noopener">Powered by Shopify</a>
      </footer>
    </main>

    {{ content_for_layout }}
  </body>
</html>
