[
  {
    "name": "theme_info",
    "theme_name": "Pulse — Wearable Tech",
    "theme_version": "1.0.0",
    "theme_author": "Wearable Tech Studio",
    "theme_documentation_url": "https://shopify.dev",
    "theme_support_url": "https://shopify.dev"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32x32 PNG)"
      },
      {
        "type": "range",
        "id": "container_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Container width",
        "default": 1280
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (soft sections)",
        "default": "#F6F7F9"
      },
      {
        "type": "color",
        "id": "color_card",
        "label": "Card background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0B1220"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#5A6473"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#E5E7EB"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#0B1220"
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "Accent contrast",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_radius",
        "label": "Button radius",
        "options": [
          { "value": "0", "label": "Square" },
          { "value": "8", "label": "Soft" },
          { "value": "999", "label": "Pill" }
        ],
        "default": "999"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Allow order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_x", "label": "X / Twitter URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  },
  {
    "name": "Social sharing image",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image (1200x630)"
      }
    ]
  }
]
