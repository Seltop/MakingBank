<section class="section">
  <div class="container" style="max-width: 480px;">
    <h1>Reset password</h1>
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-field"><label>New password</label><input type="password" name="customer[password]" required></div>
      <div class="form-field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn--primary btn--full">Reset password</button>
    {% endform %}
  </div>
</section>
