<section class="section">
  <div class="container" style="max-width: 480px;">
    <h1>Create account</h1>
    {% form 'create_customer' %}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-row">
        <div class="form-field"><label>First name</label><input type="text" name="customer[first_name]"></div>
        <div class="form-field"><label>Last name</label><input type="text" name="customer[last_name]"></div>
      </div>
      <div class="form-field"><label>Email</label><input type="email" name="customer[email]" required></div>
      <div class="form-field"><label>Password</label><input type="password" name="customer[password]" required></div>
      <button type="submit" class="btn btn--primary btn--full">Create account</button>
      <p style="margin-top: 16px; font-size: 13px;">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
    {% endform %}
  </div>
</section>
