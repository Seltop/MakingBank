<section class="hero" style="background-color: {{ section.settings.bg_color }};">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="eager" width="2400" height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}">
      <div class="hero__overlay"></div>
    </div>
  {%- else -%}
    <div class="hero__visual hero__visual--rings" aria-hidden="true"></div>
    <div class="hero__ring-stage hero__ring-stage--solo" aria-hidden="true">
      <span class="hero__ring-glow"></span>
      <img
        class="hero__ring-photo hero__ring-photo--gold"
        src="{{ 'pulse-ring-gold.png' | asset_url }}"
        alt="Pulse smart ring in gold finish"
        loading="eager"
        width="900" height="900">
    </div>
  {%- endif -%}

  <div class="container">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--lg">
            {{ section.settings.cta_text }}
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--outline btn--lg hero__cta-outline">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hero__features">
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon, size: 16 %}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="hero__fade" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Fallback color", "default": "#0B1220" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Pulse Ring — Generation 3" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Health intelligence, in a ring you'll forget you're wearing." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sleep. Recovery. Heart rate. Skin temperature. The lightest titanium ring on the market — engineered for 7 days of continuous insight." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop the Pulse Ring" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature pill",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "pulse", "label": "Pulse" },
            { "value": "sleep", "label": "Sleep" },
            { "value": "activity", "label": "Activity" },
            { "value": "battery", "label": "Battery" },
            { "value": "water", "label": "Water" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "pulse"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "24/7 heart rate" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "icon": "pulse", "text": "24/7 heart rate" } },
      { "type": "feature", "settings": { "icon": "sleep", "text": "Sleep tracking" } },
      { "type": "feature", "settings": { "icon": "battery", "text": "7-day battery" } },
      { "type": "feature", "settings": { "icon": "water", "text": "Waterproof 100m" } }
    ]
  }
}
{% endschema %}
