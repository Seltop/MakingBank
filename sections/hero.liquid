<section class="hero" style="background-color: {{ section.settings.bg_color }};">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="eager" width="2400" height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}">
      <div class="hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="container">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="color: rgba(255,255,255,0.75);">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--lg" style="background:#fff;color:#0B1220">
            {{ section.settings.cta_text }}
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--outline btn--lg" style="border-color: rgba(255,255,255,0.4); color:#fff">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hero__features">
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon, size: 16 %}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Fallback color", "default": "#0B1220" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wearable Tech, Reimagined" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your health. Optimize your life." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Smart rings, watches, and fitness trackers engineered for sleep, recovery, and performance - beautifully designed for everyday wear." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop wearables" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature pill",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "pulse", "label": "Pulse" },
            { "value": "sleep", "label": "Sleep" },
            { "value": "activity", "label": "Activity" },
            { "value": "battery", "label": "Battery" },
            { "value": "water", "label": "Water" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "pulse"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "24/7 heart rate" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "icon": "pulse", "text": "24/7 heart rate" } },
      { "type": "feature", "settings": { "icon": "sleep", "text": "Sleep tracking" } },
      { "type": "feature", "settings": { "icon": "battery", "text": "7-day battery" } },
      { "type": "feature", "settings": { "icon": "water", "text": "Waterproof 10ATM" } }
    ]
  },
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
