<section>
  <div class="page-hero container">
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="container" style="padding-bottom: 80px;">
    <div class="contact-grid">
      <div class="contact-info">
        <h3>Get in touch</h3>
        <ul>
          {%- if section.settings.email != blank -%}
            <li>{% render 'icon', name: 'mail', size: 18 %} <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>{% render 'icon', name: 'phone', size: 18 %} <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></li>
          {%- endif -%}
        </ul>
        {%- if section.settings.body != blank -%}
          <div class="rte" style="font-size: 15px;">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      <div>
        {% form 'contact', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <div class="form-success">Thanks! We'll be in touch soon.</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-error">
              <strong>Please correct the following:</strong>
              <ul style="margin: 8px 0 0; padding-left: 20px;">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-row">
            <div class="form-field">
              <label for="ContactName">Name</label>
              <input type="text" id="ContactName" name="contact[name]" required>
            </div>
            <div class="form-field">
              <label for="ContactEmail">Email</label>
              <input type="email" id="ContactEmail" name="contact[email]" required>
            </div>
          </div>
          <div class="form-field">
            <label for="ContactPhone">Phone (optional)</label>
            <input type="tel" id="ContactPhone" name="contact[phone]">
          </div>
          <div class="form-field">
            <label for="ContactMessage">Message</label>
            <textarea id="ContactMessage" name="contact[body]" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--lg">Send message</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Reach out with questions about products, orders, or technical support - we typically reply within 24 hours." },
    { "type": "text", "id": "email", "label": "Email", "default": "support@example.com" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "richtext", "id": "body", "label": "Body" }
  ]
}
{% endschema %}
