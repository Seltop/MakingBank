<section class="section">
  <div class="container">
    <div class="track-health">
      <div class="track-health__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p class="text-muted">{{ section.settings.body }}</p>
        {%- if section.blocks.size > 0 -%}
          <ul class="track-health__bullets">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check', size: 18 %}
                {{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <div style="margin-top: 28px;">
            <a href="{{ section.settings.cta_link }}" class="btn btn--primary">{{ section.settings.cta_text }} {% render 'icon', name: 'arrow-right', size: 14 %}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Track your health",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Health from your finger or wrist" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your health from your finger or wrist" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Continuous monitoring around the clock - without bulky equipment. Our wearables capture biometric signals from heart rate to HRV, skin temperature, blood oxygen, and sleep stages." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore the technology" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Heart rate, HRV, blood oxygen" }]
    }
  ],
  "default": {
    "blocks": [
      { "type": "bullet", "settings": { "text": "Continuous heart rate, HRV & SpO2" } },
      { "type": "bullet", "settings": { "text": "Advanced sleep stages & recovery score" } },
      { "type": "bullet", "settings": { "text": "Skin temperature & stress monitoring" } },
      { "type": "bullet", "settings": { "text": "Workout & VO2 Max tracking" } }
    ]
  }
}
{% endschema %}
