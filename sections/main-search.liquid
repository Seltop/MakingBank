<section class="section">
  <div class="container">
    <h1 style="margin-bottom: 16px;">Search</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 540px; margin-bottom: 32px;">
      <div style="display:flex; gap:8px;">
        <input
          type="search" name="q" value="{{ search.terms | escape }}"
          placeholder="Search products..."
          style="flex:1; padding: 14px 18px; border: 1px solid var(--color-border); border-radius: 999px;">
        <button type="submit" class="btn btn--primary">Search</button>
      </div>
      <input type="hidden" name="type" value="product">
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="text-muted" style="margin-bottom: 24px;">{{ search.results_count }} results for "{{ search.terms }}"</p>
        {%- paginate search.results by 24 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- else -%}
        <p class="text-muted">No results for "{{ search.terms }}". Try different keywords.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
