<section class="section section--soft">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in recommendations.products limit: section.settings.product_count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- elsif product != blank -%}
      <div id="ProductRecsContainer" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_count }}"></div>
      <script>
        (function(){
          var el = document.getElementById('ProductRecsContainer');
          if (!el) return;
          fetch(el.dataset.url).then(function(r){ return r.text(); }).then(function(html){
            var d = document.createElement('div'); d.innerHTML = html.trim();
            var section = d.querySelector('.section');
            if (section) el.parentElement.parentElement.replaceWith(section);
          });
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "product_count", "min": 4, "max": 12, "step": 4, "label": "Number of products", "default": 4 }
  ]
}
{% endschema %}
