<section class="section">
  <div class="container">
    <div class="page-hero" style="padding: 0 0 32px;">
      <h1>{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 12 -%}
      <div class="product-grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="product-card" style="text-decoration:none;">
            <div class="product-card__media-wrap">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy" width="800" height="{{ 800 | divided_by: article.image.aspect_ratio | round }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="product-card__info">
              <span class="product-card__vendor">{{ article.published_at | date: '%b %d, %Y' }}</span>
              <h3 class="product-card__title">{{ article.title }}</h3>
              <p class="text-muted" style="font-size: 13px;">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
