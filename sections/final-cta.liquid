<section class="section">
  <div class="container">
    <div class="final-cta">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="color: rgba(255,255,255,0.7);">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--lg" style="background:#fff;color:#0B1220">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--outline btn--lg" style="border-color: rgba(255,255,255,0.4); color:#fff">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready to upgrade?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Optimize your health, starting today." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join 100,000+ members tracking their sleep, recovery, and performance with Pulse wearables." },
    { "type": "text", "id": "cta_text", "label": "Primary CTA", "default": "Shop wearables" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA", "default": "Learn more" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
