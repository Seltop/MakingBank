{%- liquid
  assign default_finishes = 'pulse-ring-gold.png,pulse-ring-silver.png,pulse-ring-black.png' | split: ','
  assign default_labels = 'Gold,Silver,Onyx' | split: ','
  assign default_subtitles = '18k titanium PVD,Brushed aerospace ti,Stealth matte coating' | split: ','
-%}
<section class="section section--soft">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="finish-picker">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign idx = forloop.index0 -%}
        {%- assign fallback_img = default_finishes[idx] -%}
        {%- assign fallback_label = default_labels[idx] | default: block.settings.title -%}
        {%- assign fallback_sub = default_subtitles[idx] -%}
        {%- assign card_url = block.settings.url | default: coll.url | default: routes.collections_url -%}
        <a href="{{ card_url }}" class="finish-card" {{ block.shopify_attributes }}>
          <div class="finish-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | default: coll.title }}" loading="lazy" width="800" height="{{ 800 | divided_by: block.settings.image.aspect_ratio | round }}">
            {%- elsif coll.featured_image != blank -%}
              <img src="{{ coll.featured_image | image_url: width: 800 }}" alt="{{ coll.title }}" loading="lazy" width="800" height="{{ 800 | divided_by: coll.featured_image.aspect_ratio | round }}">
            {%- elsif fallback_img != blank -%}
              <img src="{{ fallback_img | asset_url }}" alt="Pulse Ring — {{ fallback_label }}" loading="lazy" width="600" height="600">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="finish-card__meta">
            <span class="finish-card__label">{{ block.settings.title | default: coll.title | default: fallback_label }}</span>
            {%- if fallback_sub != blank and block.settings.image == blank and coll.featured_image == blank -%}
              <span class="finish-card__sub">{{ fallback_sub }}</span>
            {%- endif -%}
            <span class="finish-card__arrow">{% render 'icon', name: 'arrow-right', size: 14 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three finishes, one ring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your finish." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Same sensor stack. Same 7-day battery. Three ways to wear it." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "Card link", "info": "Overrides the collection link. Use this to point a finish card at a product, page, or external URL." },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "title", "label": "Override title" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "collection" }, { "type": "collection" }, { "type": "collection" }
    ]
  }
}
{% endschema %}
