<section class="section section--dark">
  <div class="container">
    <div class="app-connect">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--on-dark">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p class="app-connect__body">{{ section.settings.body }}</p>

        <div class="app-connect__stores">
          {%- if section.settings.app_store_link != blank -%}
            <a class="app-store-btn" href="{{ section.settings.app_store_link }}" target="_blank" rel="noopener">
              <span><small>Download on the</small><strong>App Store</strong></span>
            </a>
          {%- else -%}
            <span class="app-store-btn app-store-btn--placeholder">
              <span><small>Download on the</small><strong>App Store</strong></span>
            </span>
          {%- endif -%}
          {%- if section.settings.play_store_link != blank -%}
            <a class="app-store-btn" href="{{ section.settings.play_store_link }}" target="_blank" rel="noopener">
              <span><small>Get it on</small><strong>Google Play</strong></span>
            </a>
          {%- else -%}
            <span class="app-store-btn app-store-btn--placeholder">
              <span><small>Get it on</small><strong>Google Play</strong></span>
            </span>
          {%- endif -%}
        </div>
      </div>

      <div>
        <div class="app-connect__phone{% if section.settings.image == blank %} app-connect__phone--mock{% endif %}">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="App preview"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
            >
          {%- else -%}
            <div class="app-mock" aria-hidden="true">
              <div class="app-mock__status">
                <span>9:41</span>
                <span class="app-mock__signal"></span>
              </div>
              <div class="app-mock__greeting">Good morning, Sam</div>
              <div class="app-mock__hero">
                <div class="app-mock__score">
                  <svg viewBox="0 0 120 120" width="120" height="120">
                    <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="8"></circle>
                    <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-accent)" stroke-width="8" stroke-linecap="round" stroke-dasharray="297" stroke-dashoffset="42" transform="rotate(-90 60 60)"></circle>
                  </svg>
                  <div class="app-mock__score-num"><strong>86</strong><span>Recovery</span></div>
                </div>
              </div>
              <div class="app-mock__metrics">
                <div class="app-mock__metric"><span>HRV</span><strong>72<small>ms</small></strong></div>
                <div class="app-mock__metric"><span>RHR</span><strong>54<small>bpm</small></strong></div>
                <div class="app-mock__metric"><span>SpO₂</span><strong>98<small>%</small></strong></div>
              </div>
              <div class="app-mock__chart">
                <div class="app-mock__chart-label"><span>Sleep stages</span><span>7h 42m</span></div>
                <div class="app-mock__chart-bars">
                  <span style="height:30%"></span><span style="height:55%"></span><span style="height:80%"></span><span style="height:70%"></span><span style="height:45%"></span><span style="height:65%"></span><span style="height:35%"></span><span style="height:50%"></span><span style="height:75%"></span><span style="height:90%"></span><span style="height:60%"></span><span style="height:40%"></span>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App connectivity",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "App connectivity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your health, in your pocket." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Sync seamlessly with the Pulse app. Personalized insights, trends over time, and integrations with Apple Health, Google Fit, and Strava." },
    { "type": "image_picker", "id": "image", "label": "App screenshot" },
    { "type": "url", "id": "app_store_link", "label": "App Store URL" },
    { "type": "url", "id": "play_store_link", "label": "Google Play URL" }
  ],
  "presets": [{ "name": "App connectivity" }]
}
{% endschema %}
