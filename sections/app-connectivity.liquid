<section class="section section--dark">
  <div class="container">
    <div class="app-connect">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color: rgba(255,255,255,0.6);">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p class="text-muted" style="color: rgba(255,255,255,0.7);">{{ section.settings.body }}</p>

        <div class="app-connect__stores">
          {%- if section.settings.app_store_link != blank -%}
            <a class="app-store-btn" href="{{ section.settings.app_store_link }}" target="_blank" rel="noopener">
              <span><small>Download on the</small><strong>App Store</strong></span>
            </a>
          {%- endif -%}
          {%- if section.settings.play_store_link != blank -%}
            <a class="app-store-btn" href="{{ section.settings.play_store_link }}" target="_blank" rel="noopener">
              <span><small>Get it on</small><strong>Google Play</strong></span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div>
        <div class="app-connect__phone">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="App preview"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App connectivity",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "App connectivity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your health, in your pocket" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Sync seamlessly with our companion app. Personalized insights, trends over time, and integrations with Apple Health, Google Fit, and Strava." },
    { "type": "image_picker", "id": "image", "label": "App screenshot" },
    { "type": "url", "id": "app_store_link", "label": "App Store URL" },
    { "type": "url", "id": "play_store_link", "label": "Google Play URL" }
  ],
  "presets": [{ "name": "App connectivity" }]
}
{% endschema %}
