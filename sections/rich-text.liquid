<section class="section">
  <div class="container">
    <div style="max-width: 760px; margin: 0 auto; text-align: {{ section.settings.alignment }};">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.content != blank -%}<div class="rte" style="font-size: 17px; line-height: 1.7;">{{ section.settings.content }}</div>{%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <div style="margin-top: 24px;">
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary">{{ section.settings.cta_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content" },
    { "type": "select", "id": "alignment", "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
      ], "default": "center"
    },
    { "type": "text", "id": "cta_text", "label": "CTA text" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
